# ---------------------------------------------------------------- this dataset
<https://vandeventer.github.io/ifc/cottage> a owl:Ontology ;
    dcterms:title "Cottage" ;
    dcterms:source <cottage.ifc> ;
    rdfs:comment "Converted from IFC4. Geometry is not carried over; the IFC file named as dcterms:source remains authoritative for it." .

inst:0R8Ea26peMi5aeVAtSU6Bs omg:hasGeometry inst:geometry .
inst:geometry a omg:Geometry ; fog:asIfc_v2x4 <cottage.ifc> .

# ---------------------------------------------------------------- terms with no LBD equivalent
cot:SoftwareSystem a owl:Class ;
    rdfs:label "Software system" ;
    rdfs:comment "A running system that drives or reads devices in the building, as distinct from a flow system. Here: the mbaigo systems." .
cot:manages a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:comment "Relates a software system to a device it drives or reads." .
cot:boundaryFacing a owl:DatatypeProperty ;
    rdfs:label "boundary facing" ;
    rdfs:comment "INTERNAL or EXTERNAL, from the IFC space boundary." .

